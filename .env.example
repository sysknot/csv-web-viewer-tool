# Application
APP_ENV=production
APP_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Madrid

# Authentication: generate with `docker compose run --rm app php bin/password-hash.php`
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='$2y$12$replace_with_a_real_bcrypt_hash'
FRONTEND_PASSWORD_HASH='$2y$12$replace_with_a_real_bcrypt_hash'

# Storage and limits
DB_PATH=/var/www/storage/database/app.sqlite
UPLOAD_MAX_SIZE=52428800
SESSION_TIMEOUT=3600
APP_PORT=8080

# Image version
IMAGE_NAME=pixelshub.azurecr.io/csv-web-viewer:0.3.0